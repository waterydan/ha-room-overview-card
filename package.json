{
  "name": "room-overview-card",
  "version": "1.3.1",
  "type": "module",
  "description": "Home Assistant room overview with integrated controls and independent device and entity exclusions",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo",
    "test": "node --test tests/*.test.js tests/control/*.test.js",
    "check": "npm test && npm run build && node --check dist/room-overview-card.js",
    "package": "node scripts/package.mjs",
    "test:browser": "npm run build:demo && node tests/native-browser.cjs",
    "build:inline": "npm run build && node scripts/inline.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "terser": "5.44.1"
  }
}
